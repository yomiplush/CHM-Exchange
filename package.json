{
  "name": "@yomiplush/chm-exchange",
  "version": "1.0.0",
  "description": "Independent, zero-backend, offline-first Ed25519 public-key exchange protocol, QR toolkit, and React UI for Certified Handmade.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "SECURITY.md",
    "INTEGRATION.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yomiplush/CHM-Exchange.git"
  },
  "homepage": "https://github.com/yomiplush/CHM-Exchange#readme",
  "bugs": {
    "url": "https://github.com/yomiplush/CHM-Exchange/issues"
  },
  "keywords": [
    "ed25519",
    "public-key-exchange",
    "qr-code",
    "certified-handmade",
    "offline-first",
    "zero-backend",
    "cryptography",
    "provenance"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node --experimental-strip-types examples/standalone/demo.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "fast-png": "^8.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
